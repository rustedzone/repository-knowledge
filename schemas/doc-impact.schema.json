{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/repository-knowledge/doc-impact.schema.json",
  "type": "object",
  "required": ["schema_version", "change_fingerprint", "impact", "reason"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "change_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "impact": {"enum": ["required", "not_required"]},
    "reason": {"type": "string", "minLength": 8}
  },
  "additionalProperties": false
}
