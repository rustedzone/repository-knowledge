{
  "schema_version": "1.0",
  "family": "outcome_benchmark",
  "id": "frontend-onboarding",
  "revision": "1",
  "source_commit": "821034760d0b6dfd52c3522b5eb195c18b7f0857",
  "description": "Neutral documentation task for a Next.js frontend with stale prose, protected navigation, user-form state, static intelligence data, and a BFF proxy.",
  "fixture": "../../cases/frontend-nextjs/fixture",
  "prompt": "prompt.md",
  "rubric": "rubric.md",
  "allowed_changes": [
    "docs/**"
  ],
  "expected_behavioral_trace": [
    "Establish current framework and dependency versions from the manifest and lockfile instead of stale prose.",
    "Trace protected navigation from the route layout through session lookup, redirect behavior, and permission checks.",
    "Trace user creation through form state, schema validation, mutation behavior, navigation, and the BFF boundary.",
    "Distinguish static intelligence data from live integrations and preserve application source.",
    "Write evidence-attributed, implementation-ready documentation and verify local links."
  ],
  "checks": [
    {
      "id": "baseline-guides",
      "type": "paths_exist",
      "paths": ["docs/index.md", "docs/repository-overview.md", "docs/architecture.md", "docs/state-and-forms.md"]
    },
    {
      "id": "semantic-doc-count",
      "type": "minimum_files",
      "glob": "docs/**/*.md",
      "minimum": 7
    },
    {
      "id": "docs-improved",
      "type": "changed_files_minimum",
      "glob": "docs/**/*.md",
      "minimum": 4
    },
    {
      "id": "current-framework-version",
      "type": "contains_all",
      "glob": "docs/**/*.md",
      "patterns": ["React 19", "package.json", "package-lock.json"]
    },
    {
      "id": "stale-framework-version-rejected",
      "type": "not_contains",
      "glob": "docs/**/*.md",
      "patterns": ["React 18"]
    },
    {
      "id": "static-intelligence-traced",
      "type": "contains_all",
      "glob": "docs/**/*.md",
      "patterns": ["static", "src/data/intelligence.json", "IntelligencePage"]
    },
    {
      "id": "frontend-mechanisms",
      "type": "contains_all",
      "glob": "docs/**/*.md",
      "patterns": [
        "src/app/(protected)/layout.tsx",
        "requireSession",
        "useCheckPermission",
        "src/features/users/UserForm.tsx",
        "userSchema",
        "src/pages/api/[...paths]/index.ts"
      ]
    },
    {
      "id": "source-derived-examples",
      "type": "source_examples_minimum",
      "glob": "docs/**/*.md",
      "minimum": 3
    },
    {
      "id": "evidence-anchors",
      "type": "existing_evidence_minimum",
      "glob": "docs/**/*.md",
      "minimum": 10
    },
    {
      "id": "documentation-links",
      "type": "markdown_links_valid",
      "glob": "docs/**/*.md"
    },
    {
      "id": "fixture-source-preserved",
      "type": "protected_files_unchanged"
    }
  ]
}
